{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoflowai.com/contracts/workflow.schema.json",
  "title": "WorkflowDefinition",
  "type": "object",
  "required": ["trigger", "conditions", "actions"],
  "properties": {
    "trigger": {
      "type": "object",
      "required": ["type", "config"],
      "properties": {
        "type": { "type": "string" },
        "config": { "type": "object" }
      }
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "operator"],
        "properties": {
          "field": { "type": "string" },
          "operator": { "enum": ["equals", "contains", "exists"] },
          "value": { "type": "string" }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "config"],
        "properties": {
          "type": { "type": "string" },
          "config": { "type": "object" }
        }
      }
    }
  }
}
